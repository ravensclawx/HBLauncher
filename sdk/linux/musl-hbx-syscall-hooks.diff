+/* HBLauncher: every syscall goes through __hbx_syscall.  libc's weak default
+ * (src/internal/hbx_syscall.c) issues the real `svc 0`; a runtime linked
+ * ahead of libc.a overrides it to provide a Linux personality elsewhere. */
+long __hbx_syscall(long, long, long, long, long, long, long);
+
+static inline long __syscall0(long n) { return __hbx_syscall(n, 0, 0, 0, 0, 0, 0); }
+static inline long __syscall1(long n, long a) { return __hbx_syscall(n, a, 0, 0, 0, 0, 0); }
+static inline long __syscall2(long n, long a, long b) { return __hbx_syscall(n, a, b, 0, 0, 0, 0); }
+static inline long __syscall3(long n, long a, long b, long c) { return __hbx_syscall(n, a, b, c, 0, 0, 0); }
+static inline long __syscall4(long n, long a, long b, long c, long d) { return __hbx_syscall(n, a, b, c, d, 0, 0); }
+static inline long __syscall5(long n, long a, long b, long c, long d, long e) { return __hbx_syscall(n, a, b, c, d, e, 0); }
+static inline long __syscall6(long n, long a, long b, long c, long d, long e, long f) { return __hbx_syscall(n, a, b, c, d, e, f); }
 
 #define VDSO_USEFUL
 #define VDSO_CGT_SYM "__kernel_clock_gettime"
diff -ruN a/src/internal/hbx_syscall.c b/src/internal/hbx_syscall.c
--- a/src/internal/hbx_syscall.c	1969-12-31 18:00:00.000000000 -0600
+++ b/src/internal/hbx_syscall.c	2026-10-28 12:50:35.601604672 -0500
@@ -0,0 +1,15 @@
+/* HBLauncher: default syscall path (real kernel).  Weak so a runtime can
+ * replace it; see arch/aarch64/syscall_arch.h. */
+__attribute__((__weak__))
+long __hbx_syscall(long n, long a, long b, long c, long d, long e, long f)
+{
+	register long x8 __asm__("x8") = n;
+	register long x0 __asm__("x0") = a;
+	register long x1 __asm__("x1") = b;
+	register long x2 __asm__("x2") = c;
+	register long x3 __asm__("x3") = d;
+	register long x4 __asm__("x4") = e;
+	register long x5 __asm__("x5") = f;
+	__asm__ __volatile__ ("svc 0" : "+r"(x0) : "r"(x8), "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5) : "memory", "cc");
+	return x0;
+}
